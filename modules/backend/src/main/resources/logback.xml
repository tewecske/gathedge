<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SECURITY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [SECURITY] %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Failed logins, rate-limit trips, permission-denied, admin actions. -->
    <logger name="security" level="INFO" additivity="false">
        <appender-ref ref="SECURITY"/>
    </logger>

    <logger name="webapp1" level="DEBUG"/>
    <logger name="io.getquill" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
