# Copy to .env and fill in. Used by docker-compose.yml and (when exported into the
# shell) by the backend's zio-config HOCON loader.

# --- Docker deployment ---
# Which optional compose services to run. `db` starts the bundled Postgres; remove it (or set
# COMPOSE_PROFILES= ) and point DB_URL at an existing server to use a database you already run.
COMPOSE_PROFILES=db
# Host port the nginx container publishes. This is the app's public entry point: it serves the
# SPA and proxies /api to the backend, which is not published itself.
HTTP_PORT=8080
# Backend JVM flags. MaxRAMPercentage sizes the heap from the container's memory limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75

# --- Postgres (docker-compose) ---
DB_NAME=webapp1
DB_USER=webapp1
DB_PASSWORD=webapp1
DB_PORT=5432

# --- Backend ---
# dev | production. Non-production auto-provisions a bootstrap admin account.
# Under production the backend refuses to start unless SESSION_COOKIE_SECURE=true,
# PUBLIC_BASE_URL is https://, and DB_PASSWORD is not the development default — i.e. it
# expects a TLS-terminating proxy in front of the web container.
APP_ENV=dev
# Interface the HTTP server binds to. 0.0.0.0 accepts connections from anywhere;
# use 127.0.0.1 to accept only local ones. (In Docker, compose forces 0.0.0.0 — the
# container is unreachable from outside its network regardless.)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Left unset on purpose. Running locally (npm run dev) the backend's own default
# jdbc:postgresql://localhost:5432/webapp1 applies; under compose the default is the bundled
# service, jdbc:postgresql://postgres:5432/webapp1. Set it only to reach an external database:
# DB_URL=jdbc:postgresql://db.example.com:5432/webapp1
# Frontend origin, used to build links in emails (e.g. group invite links). For a Docker
# deployment this is the nginx origin — http://localhost:${HTTP_PORT} locally, or your real
# https:// host in production. Local dev (Vite) uses http://localhost:5173.
PUBLIC_BASE_URL=http://localhost:8080

# Set to true only when the backend is served over HTTPS (e.g. behind a TLS-terminating
# proxy in production). Must stay false for local http:// dev or session cookies won't
# be sent by the browser.
SESSION_COOKIE_SECURE=false

# Bootstrap admin auto-provisioned when APP_ENV != production and no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# --- Google OAuth2 "quick sign-in" ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# The redirect URI is a browser-visible URL, so it points at the public origin (nginx proxies
# /api through to the backend), not at the backend container.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# --- Netty ---
# Event loop threads. 0 lets Netty decide (2x available processors).
NETTY_MAX_THREADS=0
