<!--
  Container logging: same loggers as modules/backend/src/main/resources/logback.xml, minus the
  RollingFileAppender — that one writes to a relative logs/ path, which is meaningless in an image
  with a read-only-ish working dir. Everything goes to stdout/stderr instead, where `docker logs`
  and any log driver can pick it up. Selected via -Dlogback.configurationFile in the Dockerfile.

  `%kvp` carries the ZIO log annotations — see the comment on the other file for why the request
  log is unreadable without it.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <appender name="SECURITY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [SECURITY] %-5level %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <!--
      Sentry: an ERROR line becomes an event, INFO and up become breadcrumbs, and with
      SENTRY_LOGS_ENABLED=true they go to Sentry Logs too. Every option comes from SENTRY_* env
      vars. With no SENTRY_DSN, or SENTRY_ENABLED=false, the appender sends nothing. The
      `security` logger below does not reach it (additivity="false").
    -->
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <minimumEventLevel>ERROR</minimumEventLevel>
        <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
        <minimumLevel>INFO</minimumLevel>
    </appender>

    <!-- Failed logins, rate-limit trips, permission-denied, admin actions. -->
    <logger name="security" level="INFO" additivity="false">
        <appender-ref ref="SECURITY"/>
    </logger>

    <logger name="gathedge" level="INFO"/>
    <logger name="io.getquill" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SENTRY"/>
    </root>

</configuration>
