# Copy to .env and fill in. Used by docker-compose.yml and (when exported into the
# shell) by the backend's zio-config HOCON loader.

# --- Docker deployment ---
# Which optional compose services to run. `db` starts the bundled Postgres; remove it (or set
# COMPOSE_PROFILES= ) and point DB_URL at an existing server to use a database you already run.
COMPOSE_PROFILES=db
# Host port the nginx container publishes. This is the app's public entry point: it serves the
# SPA and proxies /api to the backend, which is not published itself.
HTTP_PORT=8080
# Backend JVM flags. MaxRAMPercentage sizes the heap from the container's memory limit. The
# -javaagent entry loads the OpenTelemetry agent (baked into the image); it stays inert until
# OTEL_JAVAAGENT_ENABLED=true below, so leaving it here costs nothing.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -javaagent:/app/opentelemetry-javaagent.jar

# --- Postgres (docker-compose) ---
DB_NAME=gathedge
DB_USER=gathedge
DB_PASSWORD=gathedge
DB_PORT=5432

# --- Vite (npm run dev) ---
# Only read outside Docker: web/vite.config.ts loads this file itself (loadEnv), so a worktree
# running its own dev stack alongside another just needs its own .env with different ports here.
# Vite's own listen port.
VITE_PORT=5173
# Backend port the /api proxy forwards to. Reuses SERVER_PORT below rather than a separate var,
# since that's what the backend actually binds to under npm run dev.

# --- Backend ---
# dev | production. Non-production auto-provisions a bootstrap admin account.
# Under production the backend refuses to start unless SESSION_COOKIE_SECURE=true,
# PUBLIC_BASE_URL is https://, and DB_PASSWORD is not the development default — i.e. it
# expects a TLS-terminating proxy in front of the web container.
APP_ENV=dev
# Interface the HTTP server binds to. 0.0.0.0 accepts connections from anywhere;
# use 127.0.0.1 to accept only local ones. (In Docker, compose forces 0.0.0.0 — the
# container is unreachable from outside its network regardless.)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Left unset on purpose. Running locally (npm run dev) the backend's own default
# jdbc:postgresql://localhost:5432/gathedge applies; under compose the default is the bundled
# service, jdbc:postgresql://postgres:5432/gathedge. Set it only to reach an external database:
# DB_URL=jdbc:postgresql://db.example.com:5432/gathedge
# The Postgres schema the app owns, inside whatever database DB_URL names. Every table lives in it,
# flyway_schema_history included, so this app can share a database with another without colliding.
# Flyway creates it on the first boot — against an external database the configured role therefore
# needs CREATE on that database. Set it to `public` for the layout from before there was a schema.
DB_SCHEMA=gathedge
# Frontend origin, used to build links in emails (e.g. the confirmation link). For a Docker
# deployment this is the nginx origin — http://localhost:${HTTP_PORT} locally, or your real
# https:// host in production. Local dev (Vite) uses http://localhost:5173.
PUBLIC_BASE_URL=http://localhost:8080

# How many reverse proxies stand between a browser and the backend. This is what decides whether
# X-Forwarded-For is believed, and it is a security setting in both directions:
#   0 — ignore the header, use the socket peer. Correct when nothing is in front (npm run dev).
#       Wrong behind a proxy: every request then shares one address, so five failed sign-ins from
#       anyone lock sign-in, sign-up and verification resends for *everybody*.
#   1 — the compose default: one nginx (the `web` container), which appends the real client.
#   2+ — add one per further hop (a CDN or ingress in front of `web`).
# Never set it higher than the number of proxies you actually run: each hop you claim is one more
# entry of an attacker-supplied header that gets treated as the client's address.
#
# Left commented out on purpose, because this one file is read by two stacks that need different
# answers: unset, `npm run dev` gets application.conf's default of 0 (nothing in front) and
# `docker compose` gets docker-compose.yml's own default of 1 (its nginx). Uncommenting it pins
# both to one value and is right only if you actually run that many proxies in both.
# TRUSTED_PROXY_HOPS=1

# How many days of sign-in history to keep in `login_attempts`. Every attempt writes a row —
# including ones the rate limiter refuses outright — so this is the one table an unauthenticated
# caller can grow at will, and the hourly reaper is what bounds it. The audit log is not swept.
LOGIN_ATTEMPT_RETENTION_DAYS=30

# How many days of usage-event history to keep in `usage_events`. Every API request writes a row,
# authenticated or not, so like LOGIN_ATTEMPT_RETENTION_DAYS this is a table an unauthenticated
# caller can grow at will. The hourly reaper deletes past this age.
USAGE_EVENT_RETENTION_DAYS=30

# How many days an *empty* guest account is kept. A guest is minted the first time a visitor tags a
# word, so one that never tagged anything is a row nobody will ever come back for. A guest that does
# hold words is never swept whatever this says — it has no address to be recovered by, but its
# transfer code may be written down somewhere.
GUEST_RETENTION_DAYS=7

# Set to true only when the backend is served over HTTPS (e.g. behind a TLS-terminating
# proxy in production). Must stay false for local http:// dev or session cookies won't
# be sent by the browser.
SESSION_COOKIE_SECURE=false

# Bootstrap admin auto-provisioned when APP_ENV != production and no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# --- Social sign-in ---
# Each provider is optional: leave the client id/secret empty and its button disappears from the
# sign-in page and its routes answer 404. The redirect URIs are browser-visible URLs, so they point
# at the public origin (nginx proxies /api through to the backend), not at the backend container,
# and each must be registered verbatim with the provider.

# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Register an app at https://entra.microsoft.com -> App registrations. Add the redirect URI under
# platform "Web". MICROSOFT_TENANT is "common" (work/school *and* personal accounts), "organizations",
# "consumers", or a tenant GUID to restrict sign-in to a single organisation.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# --- Email verification ---
# Off by default. The verification link is sent and works either way; switching this on refuses
# password logins for accounts that have not followed it yet. Under APP_ENV=production the backend
# refuses to start with this on and no SMTP_HOST, since nobody could then receive the link.
REQUIRE_EMAIL_VERIFICATION=false

# --- Outgoing mail ---
# Leave SMTP_HOST empty to log mail instead of sending it — the dev default, which is how you read
# a verification link off the backend's stdout.
MAIL_FROM=no-reply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true

# --- Captcha (Cloudflare Turnstile) ---
# Both keys empty = the feature is off: no widget renders and the guarded endpoints skip
# verification, which is what keeps local dev and the e2e suite running with nothing configured.
# CAPTCHA_SITE_KEY is public (the browser renders the widget with it); CAPTCHA_SECRET must stay
# server-side. Free keys: https://dash.cloudflare.com -> Turnstile.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# How many failed sign-in attempts one client address may make before the sign-in form demands a
# captcha. Below the sign-in rate limiter's hard lockout of 5.
CAPTCHA_LOGIN_THRESHOLD=2

# --- Observability (OpenTelemetry) ---
# The backend can emit distributed traces (one per request, with a child span per SQL statement)
# plus JVM and HikariCP-pool metrics, over OTLP. Off by default. The OpenTelemetry Java agent is
# the source of the SQL spans and the metrics; the app adds only the HTTP server span. It is
# loaded by `docker compose` (baked into the image) and by `~backend/reStart` / `npm run dev`
# (resolved by sbt), but only when OTEL_JAVAAGENT_ENABLED=true.
#
#   Whole stack in Docker:
#     OTEL_JAVAAGENT_ENABLED=true
#     docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d --build
#
#   App from sbt, Jaeger in Docker:
#     OTEL_JAVAAGENT_ENABLED=true
#     docker compose -f docker-compose.observability.yml up -d jaeger
#     npm run dev
#
# Either way, open http://localhost:16686 and pick service `gathedge-backend`.
#
# Jaeger is traces only. For latency percentiles, time-series per endpoint/query, and production,
# install SigNoz (signoz.io/docs/install/docker), set OTEL_EXPORTER_OTLP_ENDPOINT to its collector
# and OTEL_METRICS_EXPORTER=otlp. The app instrumentation is backend-agnostic OTLP.
OTEL_JAVAAGENT_ENABLED=false
OTEL_SERVICE_NAME=gathedge-backend
# Left unset on purpose: the agent's own default is http://localhost:4317 (right for a backend run
# from sbt against the Jaeger below), and docker-compose.yml defaults its backend service to
# http://jaeger:4317 (right on the compose network). Set it only to reach something else, e.g. a
# separate SigNoz collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# parentbased_traceidratio + 1.0 traces every request. Lower the ratio (e.g. 0.1) under load;
# metrics stay complete regardless of the trace sample rate.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# none while the backend is Jaeger (it rejects metrics); otlp once it is SigNoz or another
# metrics-capable OTLP endpoint.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Host ports for the local Jaeger in docker-compose.observability.yml (web UI, then OTLP in).
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Netty ---
# Event loop threads. 0 lets Netty decide (2x available processors).
NETTY_MAX_THREADS=0
# Global request body cap, in bytes. Headroom over the bulk word upload's own 2 MiB limit.
NETTY_MAX_REQUEST_BODY_BYTES=4194304

# --- Vocabulary usage quotas ---
# Two independent, standing per-account caps — not time-windowed like the sign-in rate limits above.
# Each has a soft threshold (the write still succeeds, with a warning) and a hard one (the write is
# refused with a 409). Tags-per-user is a straight count of tags one account owns. Word-pairs-per-user
# counts word_tag_pairs rows summed across every tag the account owns — marking one translation as a
# practice answer writes two rows (one per direction), so it counts twice.
TAGS_PER_USER_SOFT_LIMIT=20
TAGS_PER_USER_HARD_LIMIT=50
WORD_PAIRS_PER_USER_SOFT_LIMIT=500
WORD_PAIRS_PER_USER_HARD_LIMIT=2000
