<!--
  `%kvp` is what makes the request log readable. zio-logging's SLF4J backend renders the ZIO log
  annotations as SLF4J key-value pairs rather than into `%msg` (SLF4J.logAppender calls
  `addKeyValue`), and `Middleware.requestLogging` in Main puts method, url, status_code and
  duration_ms there — so without `%kvp` every request is an indistinguishable "Http request served".
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <appender name="SECURITY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [SECURITY] %-5level %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/backend.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/backend.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <!-- Failed logins, rate-limit trips, permission-denied, admin actions. -->
    <logger name="security" level="INFO" additivity="false">
        <appender-ref ref="SECURITY"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="webapp1" level="DEBUG"/>
    <logger name="io.getquill" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
