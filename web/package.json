{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract-assets.mjs && node scripts/gen-site-meta.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract-assets.mjs && node scripts/gen-site-meta.mjs",
    "build": "vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@scala-js/vite-plugin-scalajs": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.50",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@scala-js/vite-plugin-scalajs": {
      "vite": "$vite"
    }
  }
